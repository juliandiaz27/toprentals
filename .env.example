# Copiar a .env.local para desarrollo local.
# En Vercel: Project → Settings → Environment Variables (Production + Preview).

# ─── Panel admin (/admin/login) ─────────────────────────────────────────────
ADMIN_TOKEN=

# ─── Vercel Blob (obligatorio en producción para guardar desde el panel) ───
# Crear en Vercel: Storage → Blob → Connect to project
BLOB_READ_WRITE_TOKEN=

# ─── GNAHS — servidor (API / descarga reservas; opcional en dev) ───────────
GNAHS_SECRET_KEY=
GNAHS_DOWNLOAD_KEY=

# ─── GNAHS — sitio público (motor, widget, mis reservas) ─────────────────────
NEXT_PUBLIC_GNAHS_WIDGET_UUID=
NEXT_PUBLIC_GNAHS_API_URL=https://hostalric.gnahs.app
NEXT_PUBLIC_GNAHS_ASSETS_URL=https://hostalric.gnahs.app/dist/
NEXT_PUBLIC_GNAHS_BOOKING_ROUTE=/reservas
NEXT_PUBLIC_GNAHS_MY_BOOKING_URL=https://hostalric.gnahs.app/top-rentals
